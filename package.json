{
  "name": "tds-clone",
  "version": "0.1.0",
  "private": true,
  "description": "todos.dev 复刻 — Free 档",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @tds/db migrate",
    "db:push": "pnpm --filter @tds/db push"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
