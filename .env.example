# ────────────────────────────────────────────────────────────────────────────
# TDS 单人局域网部署 —— 环境变量示例
# ────────────────────────────────────────────────────────────────────────────
#
# 用法：
#   1. 复制这份为 `.env`，再按需覆盖每一行的值
#         cp .env.example .env
#   2. **不要**把 `.env` 提交到仓库（已在 .gitignore 里）
#   3. server (apps/server) 与 web (apps/web) 都从 shell 拿环境变量：
#      - 直接跑：把这一份 `set -a; source .env; set +a` 然后启动
#      - 用 PM2 / hub：把每行 `KEY=value` 写进启动 env
#      - 用 next dev：它读 `NEXT_PUBLIC_*` 那一组
#
# 必填 / 选填的判断标准来自实测契约（local://lan-hardening-contract.md），
# 下面是单机局域网部署的最小可工作集合。
#
# 本机实测网卡（2026-10-18，os.networkInterfaces）：
#   以太网     10.0.0.226
#   ZeroTier  172.30.48.214 / 10.147.18.61 / 192.168.196.61
# （Hyper-V 虚拟网卡 172.25.160.1 不要用）

# ─── 监听 ──────────────────────────────────────────────────────────────────
# HOST：后端 Fastify 绑的地址。
#   单机访问本地：默认 127.0.0.1 即可（无需配 CORS 白名单）。
#   局域网访问：必须 0.0.0.0 才能让别的机器连进来。
#      单人部署推荐 0.0.0.0；
#      只在本机访问的兜底开发可保持 127.0.0.1。
# 必填：是（局域网时）。否则端口仅本机可达。
HOST=0.0.0.0

# PORT：后端端口，默认 4000（apps/server/src/main.ts 第 35 行）。
# 改端口时记得同步更新下面的 TDS_CORS_ORIGIN 与 web 的 NEXT_PUBLIC_API_BASE。
# 必填：否。
PORT=4000

# ─── CORS 白名单（仅后端要，web 端通过 BFF 不用直接读这个）────────────────
# 当 HOST 是非回环地址时，必须配 TDS_CORS_ORIGIN，否则浏览器侧会被拒。
# 格式：逗号分隔的精确 origin（scheme://host[:port]），不能带尾部斜杠。
# 局域网部署必须包含：
#   - 局域网内用 http://<主机 IP>:3000 访问 web 的 origin
#   - 本机自访问的 http://127.0.0.1:3000（避免从主机自己反代时撞墙）
# 必填：HOST 非回环时是。
TDS_CORS_ORIGIN=http://10.0.0.226:3000,http://127.0.0.1:3000

# ─── 凭据加密 ──────────────────────────────────────────────────────────────
# TDS_KEK：AES-256-GCM 主密钥，base64 编码的 32 字节（= 44 个 base64 字符）。
# 用以加密 secrets 与 API key。本项目在生产模式下缺失会直接 throw；
# 开发模式下会用确定性派生，但每次重启使用相同值加密的旧数据可能解不出来。
# 生成命令（Node 标准库）：见 DEPLOY-LAN.md 第三章。
# 必填：是（部署一次就别再换，换了旧数据全部解不出来）。
TDS_KEK=

# ─── Web 端登录（仅后端要）──────────────────────────────────────────────────
# TDS_WEB_TOKEN：Web 端登录密码。Browser 端登录页 (`/login`) 输入这个值后
# 下发 httpOnly cookie `tds_token`。后端按它解析出「当前用户」。
# 取个任意随机串即可，无格式要求。建议 ≥ 32 字符随机。
# 必填：是（HOST 非回环时）。
#       不配时，BFF 端的鉴权是「开发态放行」（apps/web/src/lib/auth.ts），
#       但**单点登录拿不到身份，后端会判 401**。
TDS_WEB_TOKEN=

# TDS_WEB_USER：把 `TDS_WEB_TOKEN` 映射到哪个用户。必须是该用户的 **email**，
# 不是 user id（实测踩过这个坑）。未配时：
#   - 单机（HOST 回环）：允许「取库里最早的用户」回退，方便开发。
#   - 局域网/HOST 非回环：服务端启动直接 process.exit(1)（实测契约）。
# 因为库里目前都是测试残留用户（email 都是 xxx@test.local），
# 所以**首次部署必须先建一个真实用户**再填这个值。
# 必填：是（局域网时）。
TDS_WEB_USER=

# ─── Web 端需要读的环境变量（仅 Next.js 进程）───────────────────────────────
# 这些以 NEXT_PUBLIC_ 前缀开头的会被编译期注入到浏览器代码里。
# server 进程不需要它们。

# NEXT_PUBLIC_API_BASE：浏览器里 BFF 调用后端的 base URL。
# 单机开发：保持 127.0.0.1（web 与 server 同机）。
# 局域网部署：填局域网能访问 server 的地址。所有客户端用同一个值。
#   注意：浏览器是从**它自己所在的网络视角**访问这个地址：
#     - 在 server 主机上的浏览器：填 http://127.0.0.1:4000
#     - 在局域网另一台机器上的浏览器：填 http://10.0.0.226:4000（同一个 server）
# 必填：是（局域网时）；单机开发可省，默认为 http://127.0.0.1:4000。
NEXT_PUBLIC_API_BASE=http://10.0.0.226:4000

# ─── 调试 / 排障开关（可选）─────────────────────────────────────────────────
# TDS_RATE_LIMIT_DISABLED：限流总开关。=1 时所有 `@fastify/rate-limit`
# 都被跳过；正常浏览不会超（实测阈值 600/min 全局 + 120/min MCP），
# 但调试脚本或大批量操作时偶尔会被卡。生产谨慎打开。
# 必填：否。
# TDS_RATE_LIMIT_DISABLED=1

# LOG_LEVEL：Fastify 的 Pino 日志级别（trace/debug/info/warn/error/fatal）。
# 默认 info。生产建议 warn 或 error 减噪。
# 必填：否。
# LOG_LEVEL=info

# ─── 数据库（可选 —— 默认值已可用）─────────────────────────────────────────
# 本机 zonky 嵌入式 Postgres 的默认连接串（与 packages/db/src/client.ts 一致）。
# 换其它部署时改这个；同机保持注释即可（开发态 fallback 走这个串）。
# 必填：否。
# DATABASE_URL=postgres://tds:tds_local_dev@127.0.0.1:5433/tds
